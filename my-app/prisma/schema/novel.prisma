// 小说服务私用表

// 关联目标类型：决定 *_ref.refId 指向哪张表
enum RefType {
  character //novel_character
  faction //novel_faction
  outline //novel_outline
  timeline //novel_timeline
  chronicle //novel_chronicle
  foreshadowing //novel_foreshadowing
  item //novel_item
  inspiration //novel_inspiration
  world_rule //novel_world_rule
  relation //novel_relation
}

// 改动波及的对象类型：sourceType（改的是谁）与 targetType（波及到谁）共用这一套取值。
// 比 RefType 多出 novel / chapter / state / relation —— 小说本身、章节、章节状态快照、角色关系
// 都不在 ref 体系里，但都是能被改动波及的东西。
enum ImpactTarget {
  novel
  chapter
  state //novel_chapter_state
  outline
  timeline
  chronicle
  character
  faction
  item
  relation
  world_rule
  foreshadowing
}

// 受影响的性质：决定这一条该怎么改，也是给用户看的分类。
enum ImpactReason {
  name_ref //正文写了旧名字/旧称呼，字面替换即可
  stale_value //正文描述了已过时的属性/数值，与改动后的设定矛盾
  state_conflict //角色状态轨迹（境界/位置/处境）从某一章起对不上
  fk_dangling //外键仍指向已删/已并的实体，成了悬空引用
  order_shift //章节增删或重排，正文里写的「第 X 章」这类文字指代对不上了（表里的章节引用已按 id 存，不受重排影响）
  plot_conflict //情节逻辑与改动后的设定不兼容
  outline_conflict //大纲/时间线/编年史的描述与改动后的内容不符
  review_issue //章节审查（reader）查出的硬伤：风格跑偏、剧情漂移、设定写崩等
  redundant //改动使这一段/这一条变成冗余
}

// 处理优先级
enum ImpactSeverity {
  must_fix //确定性错误，不改就是坏的
  review //该不该改要人来判断
  info //仅供参考
}

// 处理进度
enum ImpactStatus {
  pending //已列出，还没问过用户
  accepted //用户同意改
  skipped //用户决定不改，先放着
  fixed //已改完
}

model novel {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("") //标题
  wordCount Int      @default(0) //字数
  tropes    String? //小说套路
  style     String? //小说风格
  reviewEnabled Boolean @default(true) // 是否开启 AI 审稿（reader 节点）；关掉后写/改完直接到确认
  banned    Boolean  @default(false)   // 是否封禁
  banReason String?                     // 封禁原因
  bannedAt  DateTime? @db.Timestamptz(3) // 封禁时间
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters       novel_chapter[]
  outlines       novel_outline[]
  characters     novel_character[]
  rules          novel_world_rule[]
  timelines      novel_timeline[]
  factions       novel_faction[]
  chronicles     novel_chronicle[]
  items          novel_item[]
  relations      novel_relation[]
  inspirations   novel_inspiration[]
  foreshadowings novel_foreshadowing[]
  changeImpacts  novel_change_impact[]

  @@index([userId])
}

model novel_chapter {
  id          String   @id @default(cuid())
  novelId     String
  title       String   @default("") //章节标题
  order       Int      @default(0) //章节序号
  status      String   @default("draft") //章节状态
  content     String   @default("") //内容
  pastSummary Json? //过去章节总结
  summary     String? //章节精简
  wordCount   Int      @default(0) //字数
  banned      Boolean  @default(false)   // 是否封禁
  banReason   String?                     // 封禁原因
  bannedAt    DateTime? @db.Timestamptz(3) // 封禁时间
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  novel        novel                       @relation(references: [id], fields: [novelId], onDelete: Cascade)
  state        novel_chapter_state?
  refs         novel_chapter_ref[]

  @@unique([novelId, order])
}

// 单章的故事状态快照，用于跨章一致性检查
model novel_chapter_state {
  id               String   @id @default(cuid())
  chapterId        String   @unique
  protagonistState String? //主角状态（境界 / 位置 / 心态等）
  storyTime        String? //该章结束时的故事内时间
  eventProgress    String? //事件进度
  worldState       String? //世界 / 势力局势
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  chapter novel_chapter @relation(references: [id], fields: [chapterId], onDelete: Cascade)
}

model novel_outline {
  id             String   @id @default(cuid())
  novelId        String
  level          String   @default("main") //分级：主线 main / 阶段线 phase / 支线 branch
  status         String //大纲状态（审校状态，不是生命周期）
  // 生命周期：这条线还在写就是 false，收尾了置 true。取代原来的 endChapterId ——
  // 「收尾章是哪一章」由该章自己的 outline ref（novel_chapter_ref）记，删除收尾章不再破坏语义。
  completed      Boolean  @default(false)
  // 包含关系：主线 ⊃ 阶段线 ⊃ 支线。阶段线挂主线、支线挂阶段线；主线自身 parentId 为空。
  // SetNull 而非 Cascade：重写某一章会撤掉「从这一章起头」的 phase/branch，级联删除会把后面
  // 章节挂在其名下的支线也一并带走 —— 那是后面的工作，不该被这一章的重写牵连。
  parentId       String?
  startChapterId String? //适用起始章节（novel_chapter.id）
  order          Int      @default(0) //排序
  content        String //大纲内容
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  parent   novel_outline?      @relation("OutlineTree", fields: [parentId], references: [id], onDelete: SetNull)
  children novel_outline[]     @relation("OutlineTree")
  novel    novel               @relation(references: [id], fields: [novelId], onDelete: Cascade)

  @@index([novelId, order])
  @@index([novelId, parentId])
}

model novel_character {
  id          String   @id @default(cuid())
  novelId     String
  name        String //姓名
  sex         String //性别
  age         String //年龄
  birthYear   String //出生年份
  deathYear   String //死亡年份
  description String //描述
  identity    String //身份
  personality String //性格
  ability     String //能力
  role        String   @default("配角") //角色身份：主角 / 配角 / 反派
  firstAppearanceChapterId String? //首次出现章节（novel_chapter.id）
  // 版本链：角色会随剧情变（境界 / 处境 / 身份）。每变一次新建一行，旧行的 next 指向新行
  // （无外键，自引用链），这一版从哪一章起生效由本行的 firstAppearanceChapterId 表达。
  // next 为空的那一行就是"当前版"。同名多版是正常的，所以不设 (novelId, name) 唯一。
  next        String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  novel novel        @relation(references: [id], fields: [novelId], onDelete: Cascade)
  items novel_item[]

  @@index([novelId, role])
  @@index([novelId, next])
}

model novel_world_rule {
  id        String   @id @default(cuid())
  novelId   String
  name      String //规则名
  rule      String //规则内容
  status    String //状态
  firstAppearanceChapterId String? //首次出现章节（novel_chapter.id）
  // 版本链：规则会改（世界的规则被改写 / 补全）。旧行的 next 指向新行（无外键，自引用链），
  // 这一版从哪一章起生效由本行的 firstAppearanceChapterId 表达。next 为空的那一行是"当前版"。
  next      String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  novel novel @relation(references: [id], fields: [novelId], onDelete: Cascade)

  @@index([novelId])
  @@index([novelId, next])
}

model novel_timeline {
  id             String   @id @default(cuid())
  novelId        String
  title          String //时间线标题
  status         String //状态
  year           String //年份
  description    String //描述
  // 记录类、值不变：只留"事件发生在哪一章"的起点，与章节的挂接走 novel_chapter_ref。endChapterId 已删。
  startChapterId String? //涉及起始章节（novel_chapter.id）
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  novel novel                @relation(references: [id], fields: [novelId], onDelete: Cascade)

  @@index([novelId])
}

model novel_faction {
  id          String   @id @default(cuid())
  novelId     String
  name        String //名称
  type        String //类型
  location    String //所在地
  description String //描述
  stance      String //立场
  // 版本链：势力会变（处境 / 立场）。旧行的 next 指向新行（无外键，自引用链），这一版从哪一章
  // 起生效由本行的 firstAppearanceChapterId 表达。next 为空的那一行是"当前版"。
  firstAppearanceChapterId String? //首次出现章节（novel_chapter.id）
  next        String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  novel novel @relation(references: [id], fields: [novelId], onDelete: Cascade)

  // 同名多版是正常的（版本链），所以不再设 (novelId, name) 唯一 —— "同时只一版开着"由写入代码守。
  @@index([novelId])
  @@index([novelId, next])
}

model novel_chronicle {
  id        String   @id @default(cuid())
  novelId   String
  title     String //事件标题
  year      String //年份
  content   String //内容
  // 记录类、值不变：只留"事件发生在哪一章"的起点。与章节的挂接另走 novel_chapter_ref。
  startChapterId String? //涉及起始章节（novel_chapter.id）
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  novel novel                 @relation(references: [id], fields: [novelId], onDelete: Cascade)

  @@index([novelId])
}

model novel_item {
  id                       String   @id @default(cuid())
  novelId                  String
  name                     String //名称
  type                     String //类型
  description              String //描述
  firstAppearanceChapterId String? //首次出现章节（novel_chapter.id）
  status                   String //状态
  ownerId                  String? //持有者（人物 id）
  // 版本链：物品会升级 / 易主。旧行的 next 指向新行（无外键，自引用链），这一版从哪一章起生效
  // 由本行的 firstAppearanceChapterId 表达。next 为空的那一行是"当前版"。
  next                     String?
  createdAt                DateTime @default(now()) @db.Timestamptz
  updatedAt                DateTime @updatedAt @db.Timestamptz

  novel novel            @relation(references: [id], fields: [novelId], onDelete: Cascade)
  owner novel_character? @relation(references: [id], fields: [ownerId], onDelete: SetNull)

  // 同名多版是正常的（版本链），不再设 (novelId, name) 唯一 —— "同时只一版开着"由写入代码守。
  @@index([novelId, firstAppearanceChapterId])
  @@index([ownerId])
  @@index([novelId, next])
}

model novel_relation {
  id           String   @id @default(cuid())
  novelId      String
  fromCharId   String //源角色 id
  toCharId     String //目标角色 id
  relationType String //关系类型
  strength     Int //关系强度
  description  String //描述
  status       String //状态
  // 版本链：关系会变（师徒 → 反目）。旧行的 next 指向新行（无外键，自引用链），这一版从哪一章
  // 起生效由本行的 firstAppearanceChapterId 表达。next 为空的那一行是"当前版"。两端
  // fromCharId / toCharId 是身份、不进版本变化（见 agents/novel/utils/ledger.py 的 VERSION_EDIT）。
  firstAppearanceChapterId String? //首次出现章节（novel_chapter.id）
  next         String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  novel novel @relation(references: [id], fields: [novelId], onDelete: Cascade)

  // 三列唯一已删（版本链下同名多版）：反查「这个角色牵涉了哪些关系」照旧用 from/to 那两条索引。
  @@index([novelId, fromCharId])
  @@index([novelId, toCharId])
  @@index([novelId, next])
}

// 全书灵感库：跨章节的构思。「用在哪些章」由 novel_chapter_ref 记（refType='inspiration'），
// 不再用数组列。
model novel_inspiration {
  id             String   @id @default(cuid())
  novelId        String
  sourceId       String   @default("") //同一份素材（一次新增）产出的多条灵感共享此 id；空串是老数据，各自成组
  title          String   @default("") //显示名（模型翻译出的短名，兜底用文件原名 / 文本首行 / URL）
  category       String[] @default(["other"]) //内容类型（可多选，尽量少选）：style/plot/character/meme/setting/scene/dialogue/imagery/emotion/technique/other
  type           String //素材形态：text/file/url（老数据可能是 image，只读兼容）
  content        String //灵感原文
  usage          String   @default("selectable") //使用策略：must 必用 / selectable 选用 / never 不用
  lifecycle      String   @default("reuse") //生命周期：reuse 复用 / once 单次（用过后退出候选）
  scenario       String   @default("") //可使用场景（模型翻译产出）
  digest         String   @default("") //写作指引（模型翻译产出，写手照它落笔）
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  novel novel @relation(references: [id], fields: [novelId], onDelete: Cascade)

  @@index([novelId])
}

// 章节灵感库已被书级灵感库 novel_inspiration 取代（「用在哪些章」改由 novel_chapter_ref 记）。

model novel_foreshadowing {
  id                String   @id @default(cuid())
  novelId           String
  description       String //伏笔描述
  resolveScenario   String   @default("") //打算在什么场景下收尾（埋的时候写清，planner 据此判断何时收）
  plantedChapterId  String? //埋设章节（novel_chapter.id）
  resolvedChapterId String? //回收章节（novel_chapter.id）
  // 收尾状态：open 未收尾 / resolved 已收尾。由写手在台账里报（埋进 new、收进 resolved），
  // 不由别的写入路径碰 —— 别的设定用 draft/done 那套审校状态，伏笔这两值只表达"收没收回"。
  status            String   @default("open")
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  novel novel @relation(references: [id], fields: [novelId], onDelete: Cascade)

  @@index([novelId, plantedChapterId])
  @@index([novelId, resolvedChapterId])
  @@index([novelId, status])
}

// 章节的关联表：这一章涉及的人物、势力、时间线、大纲、编年史、伏笔、物品、灵感、世界规则。
// refType 决定 refId 指向哪张表；role 是戏份，九类通用（见 agents/novel/utils/ledger.py 的
// ROLE_VALUES）。refId 上没有外键 —— refType 决定它指向哪张表，一个列没法对九张表建约束，
// 所以悬空 id 靠影响检测去报，不靠库拦。大纲 / 时间线 / 编年史 与章节的挂接也走这张表，
// 它们各自的 *_ref 从未被写入，已随本次清理删除。
model novel_chapter_ref {
  id        String   @id @default(cuid())
  chapterId String
  refType   RefType
  refId     String //目标行 id
  role      String? //戏份：key 关键 / state 状态 / mention 提及
  createdAt DateTime @default(now()) @db.Timestamptz

  chapter novel_chapter @relation(references: [id], fields: [chapterId], onDelete: Cascade)

  @@unique([chapterId, refType, refId])
  @@index([refType, refId])
}

// 改动影响台账：一次改动牵连到的每一处地方各占一行。
//
// 用户能改的地方多（章节 / 角色 / 势力 / 物品 / 大纲 / 时间线 / 世界规则 …），不同的改动波及
// 的地方又各不相同。这张表不试图穷举「哪种改动影响哪些表」——那种映射是 N×M，永远配不完。
// 它把每次改动归一成「改了什么 → 波及哪里 → 为什么受影响 → 处理了没有」平铺成行：
//   - 同样的 changeId 是一组，代表用户这一次的修改需求；
//   - reason 写清「为什么受影响」，用户逐条看得懂是改名就行还是得重写这一章；
//   - status 承载「用户不要求修改就先放着」——skipped 的行留在表里，不删。
// editor 只负责生成行，真正改哪一条由用户逐行确认。
model novel_change_impact {
  id            String         @id @default(cuid())
  novelId       String
  changeId      String //一次改动一个 id；同一批影响共享，用于分组
  changeSummary String //这次改动的人话描述，例：把林默的能力改成「看见三秒后的画面」
  sourceType    ImpactTarget //改动的是哪一类对象
  sourceId      String //改动对象的 id
  oldValue      String? //改动前的值（字面替换要用）
  newValue      String? //改动后的值；纯新增/删除时一端可为空
  targetType    ImpactTarget //被波及的是哪一类对象
  targetId      String //被波及对象的 id
  targetChapter Int? //目标若是章节，这里存落库时的章节号快照，仅供展示排序；
  //章节重排后它会失真，定位一律以 targetId 为准
  reasonKind    ImpactReason //受影响原因的分类，便于统计与排序
  reason        String //受影响原因（人话），直接展示给用户
  severity      ImpactSeverity @default(review)
  status        ImpactStatus   @default(pending)
  resolution    String? //实际怎么处理的，改完回填
  detectedBy    String         @default("") //哪一层查出来的：ref / name_match / semantic，排查误报用
  createdAt     DateTime       @default(now()) @db.Timestamptz
  updatedAt     DateTime       @updatedAt @db.Timestamptz

  novel novel @relation(references: [id], fields: [novelId], onDelete: Cascade)

  // 同一批改动、同一个对象、同一种原因只留一行：检测可以重复跑，靠 upsert 保持幂等。
  @@unique([changeId, targetType, targetId, reasonKind])
  @@index([novelId, status])
  @@index([novelId, targetType, targetId])
  @@index([changeId])
}
