generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                      String    @id @default(cuid())
  accountId               String
  providerId              String
  userId                  String
  accessToken             String?
  refreshToken            String?
  idToken                 String?
  accessTokenExpiresAt    DateTime? @db.Timestamptz
  refreshTokenExpiresAt   DateTime? @db.Timestamptz
  scope                   String?
  password                String?
  createdAt               DateTime  @default(now()) @db.Timestamptz
  updatedAt               DateTime  @updatedAt @db.Timestamptz

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index([userId])
}

model temp_file {
  id           String    @id @default(cuid())
  userId       String
  threadId     String
  fileHash     String
  originalName String
  mimeType     String
  description  String?
  sizeBytes    Int
  data         Bytes
  createdAt    DateTime  @default(now()) @db.Timestamptz
  expiresAt    DateTime  @default(dbgenerated("(now() + interval '7 days')")) @db.Timestamptz

  @@unique([userId, threadId, fileHash])
  @@index([expiresAt])
}

model created_file {
  id           String    @id @default(cuid())
  userId       String
  threadId     String
  originalName String
  mimeType     String
  description  String?
  sizeBytes    Int
  data         Bytes
  createdAt    DateTime  @default(now()) @db.Timestamptz
  expiresAt    DateTime  @default(dbgenerated("(now() + interval '7 days')")) @db.Timestamptz

  @@index([userId, threadId])
  @@index([expiresAt])
}

model checkpoint {
  id           String   @id @default(cuid())
  userId       String
  agentName    String
  threadId     String
  checkpointId String
  state        Json
  metadata     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@unique([userId, agentName, threadId, checkpointId])
  @@index([userId, agentName, threadId])
  @@index([userId])
}

model agent_store {
  id        String   @id @default(cuid())
  userId    String
  agentName String
  key       String
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([userId, agentName, key])
  @@index([userId])
}

model user_session {
  id        String   @id @default(cuid())
  userId    String
  agentName String
  threadId  String
  title     String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  history user_session_history?

  @@unique([userId, agentName, threadId])
  @@index([userId, agentName])
}

model user_session_history {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   user_session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  messages  Json
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model bm25 {
  id           String   @id @default(cuid())
  chunk_id     String   @unique // Chroma laws_docs 的 id：{file_id}_{chunk_index}
  content      String
  heading      String?
  file_id      String
  chunk_index  Int
  parent_index Int? // 所属父模块序号（父文本在 laws 表，键 {file_id}_P{parent_index}）
  created_at   DateTime @default(now()) @db.Timestamptz

  @@index([file_id])
}

model laws {
  id           String   @id @default(cuid())
  parent_id    String   @unique // 父模块 id：{file_id}_P{parent_index}
  file_id      String
  parent_index Int
  heading      String? // 父标题：法规名 / 章标题
  content      String // 父模块全文（含各子条标题）
  created_at   DateTime @default(now()) @db.Timestamptz

  @@index([file_id, parent_index])
}